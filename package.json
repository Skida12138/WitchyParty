{
  "name": "witchy-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "logs": "node --env-file-if-exists=.env scripts/room-logs.mjs",
    "invite:generate": "node scripts/generate-invite.mjs",
    "check": "npm run test && npm run build",
    "dev:rust": "node scripts/dev.mjs --rust",
    "dev:server:rust": "cargo run -p witchy-web-server",
    "start:rust": "cargo run --release -p witchy-web-server",
    "test:rust": "cargo test --workspace && cargo build -p witchy-web-server --bins --examples && node scripts/test-rust.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "@playwright/test": "^1.56.1"
  }
}
