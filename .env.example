# Copy to .env and supply your own key. Model API keys stay on the server.
# Every game uses DeepSeek. Without a key, rooms may gather but cannot start.
# Required access gate. Generate with: npm run invite:generate
# Store only the SHA-256 hex digest here; share the generated UUID with friends.
# Empty or invalid configuration denies all game API/WebSocket access.
INVITE_CODE_SHA256=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Bot material decisions think; pricing/synthesis keep their fast mode.
DEEPSEEK_BOT_THINKING=enabled
HOST=127.0.0.1
PORT=3001
# Keep seats and an empty room briefly so refreshing can reconnect safely.
RECONNECT_GRACE_MS=30000
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=10000
# Visual performance timing. Model work finishes before these steps play.
# DEPOSIT_MS=1800
# REACTION_MS=2400
# HOLD_MS=1500
# CHAIN_HOLD_MS=1000
# Local diagnostics only; never served to players. Set to 0 to disable.
ROOM_LOG_ENABLED=1
ROOM_LOG_DIR=logs/rooms
